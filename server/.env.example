# Copy to server/.env and fill in. Never commit .env.
PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Required
DB_URL=mongodb://127.0.0.1:27017/reviewflow
REDIS_URL=rediss://default:password@host:6379
ACCESS_TOKEN=change-me-at-least-32-characters-long
REFRESH_TOKEN=change-me-too-at-least-32-characters

# Optional auth tuning
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ACTIVATION_TOKEN_TTL_SECONDS=900
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PLATFORM_ADMIN_EMAIL=

# E-mail notifications (skipped silently when SMTP_MAIL is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=

# Video storage (needs ffmpeg + ffprobe on PATH)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=1024
STREAM_SECRET=
GUEST_SECRET=

# AI publish kit. You need ONE of these (free keys, no card):
#   GEMINI_API_KEY  -> aistudio.google.com/apikey   (text + image + audio: does everything)
#   GROQ_API_KEY    -> console.groq.com/keys        (fast Llama + Whisper; no image understanding, frames are ranked locally)
# Paid options: ANTHROPIC_API_KEY (best copy), OPENAI_API_KEY (Whisper only).
# Free tiers may use your inputs to improve the provider's models: use test videos, not client-confidential ones.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=            # optional: gemini | groq | anthropic (default: first one with a key)
# Model names change; override if a default is retired, e.g. GEMINI_MODEL_SMART=gemini-2.5-flash
AI_RATE_LIMIT_PER_HOUR=5

# Publishing (Phase 3)
PUBLIC_API_URL=http://localhost:8000   # must be a public https URL for Instagram (Meta fetches the video)
TOKEN_ENC_KEY=                         # encrypts stored OAuth tokens; falls back to a derived key
# YouTube uses GOOGLE_CLIENT_ID/SECRET above. Redirect URI: ${PUBLIC_API_URL}/v1/social/youtube/callback
META_APP_ID=
META_APP_SECRET=                       # Instagram redirect URI: ${PUBLIC_API_URL}/v1/social/instagram/callback

# Email (pick one). Test with: npm run mail:test -- you@example.com
# A) Resend (free tier, easiest): resend.com -> API key. Without a verified domain it can only send to your own account email.
RESEND_API_KEY=
MAIL_FROM=CreatorFlow <onboarding@resend.dev>
# B) Any SMTP (Gmail app password, Brevo, SES...): see SMTP_* above.
